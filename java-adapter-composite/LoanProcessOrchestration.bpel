<?xml version="1.0" encoding="UTF-8"?>
<process name="LoanProcessOrchestration"
         targetNamespace="http://xmlns.oracle.com/JavaAdapterTest/LoanProcessOrchestration"
         xmlns="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema"
         xmlns:bpelx="http://schemas.oracle.com/bpel/extension"
         xmlns:ora="http://schemas.oracle.com/xpath/extension"
         xmlns:tns="http://xmlns.oracle.com/JavaAdapterTest/LoanProcessOrchestration"
         xmlns:types="http://xmlns.oracle.com/JavaAdapterTest/types">

    <!-- ================================================================== -->
    <!-- Loan Process Orchestration - Multiple Java Adapter Embeddings      -->
    <!-- Single BPEL invoking 4 Java adapters via <bpelx:exec>              -->
    <!--                                                                    -->
    <!-- Java Adapters (from SCA-INF/lib/):                                 -->
    <!--   1. DecisionEngine      - Loan underwriting decision              -->
    <!--   2. DTICalculator       - DTI/LTV ratio calculations              -->
    <!--   3. OCRProcessor        - Document OCR processing                 -->
    <!--   4. AmortizationCalculator - Payment/pricing calculations         -->
    <!-- ================================================================== -->

    <partnerLinks>
        <partnerLink name="LoanProcessClient"
                     partnerLinkType="tns:LoanProcessPLT"
                     myRole="LoanProcessProvider"/>
    </partnerLinks>

    <variables>
        <variable name="inputVariable" messageType="tns:LoanProcessRequestMessage"/>
        <variable name="outputVariable" messageType="tns:LoanProcessResponseMessage"/>
        <!-- Intermediate variables for Java adapter results -->
        <variable name="dtiRatio" type="xsd:double"/>
        <variable name="ltvRatio" type="xsd:double"/>
        <variable name="documentType" type="xsd:string"/>
        <variable name="ocrConfidence" type="xsd:int"/>
        <variable name="decisionStatus" type="xsd:string"/>
        <variable name="riskScore" type="xsd:int"/>
        <variable name="interestRate" type="xsd:double"/>
        <variable name="monthlyPayment" type="xsd:double"/>
    </variables>

    <sequence name="MainSequence">

        <!-- Receive loan application request -->
        <receive name="ReceiveRequest"
                 partnerLink="LoanProcessClient"
                 operation="processLoan"
                 variable="inputVariable"
                 createInstance="yes"/>

        <!-- ============================================================== -->
        <!-- STEP 1: DTI/LTV Calculation (DTICalculator Java Adapter)       -->
        <!-- JAR: SCA-INF/lib/dti-calculator.jar                            -->
        <!-- ============================================================== -->

        <bpelx:exec name="CalculateDTI" language="java">
            <![CDATA[
                // Instantiate the DTI Calculator Java Adapter
                com.soa.adapters.DTICalculator calculator = new com.soa.adapters.DTICalculator();

                // Get loan data from input variables
                double monthlyIncome = Double.parseDouble(
                    (String)getVariableData("inputVariable", "payload", "/types:LoanProcessRequest/types:monthlyIncome"));
                double monthlyDebt = Double.parseDouble(
                    (String)getVariableData("inputVariable", "payload", "/types:LoanProcessRequest/types:monthlyDebt"));
                double loanAmount = Double.parseDouble(
                    (String)getVariableData("inputVariable", "payload", "/types:LoanProcessRequest/types:loanAmount"));
                double propertyValue = Double.parseDouble(
                    (String)getVariableData("inputVariable", "payload", "/types:LoanProcessRequest/types:propertyValue"));

                // Calculate DTI and LTV ratios
                double dti = calculator.calculateDTI(monthlyIncome, monthlyDebt);
                double ltv = calculator.calculateLTV(loanAmount, propertyValue);

                // Set results to BPEL variables
                setVariableData("dtiRatio", Double.valueOf(dti));
                setVariableData("ltvRatio", Double.valueOf(ltv));

                addAuditTrailEntry("DTI Calculator: DTI=" + dti + "%, LTV=" + ltv + "%");
            ]]>
        </bpelx:exec>

        <!-- ============================================================== -->
        <!-- STEP 2: Document OCR Processing (OCRProcessor Java Adapter)    -->
        <!-- JAR: SCA-INF/lib/ocr-processor.jar                             -->
        <!-- ============================================================== -->

        <bpelx:exec name="ProcessOCR" language="java">
            <![CDATA[
                // Instantiate the OCR Processor Java Adapter
                com.soa.adapters.OCRProcessor processor = new com.soa.adapters.OCRProcessor();

                // Get document data from input (if provided)
                byte[] documentData = null;
                try {
                    String docBase64 = (String)getVariableData("inputVariable", "payload",
                        "/types:LoanProcessRequest/types:documentData");
                    if (docBase64 != null && !docBase64.isEmpty()) {
                        documentData = java.util.Base64.getDecoder().decode(docBase64);
                    }
                } catch (Exception e) {
                    // No document data provided - use default
                    documentData = "Sample W-2 wage and tax statement".getBytes();
                }

                // Process document with OCR
                com.soa.adapters.OCRProcessor.OCRResult result = processor.processDocument(documentData);

                // Set results to BPEL variables
                setVariableData("documentType", result.getDocumentType());
                setVariableData("ocrConfidence", Integer.valueOf(result.getConfidence()));

                addAuditTrailEntry("OCR Processor: Type=" + result.getDocumentType() +
                    ", Confidence=" + result.getConfidence() + "%");
            ]]>
        </bpelx:exec>

        <!-- ============================================================== -->
        <!-- STEP 3: Underwriting Decision (DecisionEngine Java Adapter)    -->
        <!-- JAR: SCA-INF/lib/decision-engine.jar                           -->
        <!-- ============================================================== -->

        <bpelx:exec name="RunDecisionEngine" language="java">
            <![CDATA[
                // Instantiate the Decision Engine Java Adapter
                com.soa.adapters.DecisionEngine engine = new com.soa.adapters.DecisionEngine();

                // Get DTI/LTV from previous step and other loan data
                double dti = ((Double)getVariableData("dtiRatio")).doubleValue();
                double ltv = ((Double)getVariableData("ltvRatio")).doubleValue();
                double loanAmount = Double.parseDouble(
                    (String)getVariableData("inputVariable", "payload", "/types:LoanProcessRequest/types:loanAmount"));
                double propertyValue = Double.parseDouble(
                    (String)getVariableData("inputVariable", "payload", "/types:LoanProcessRequest/types:propertyValue"));

                // Build loan data map for decision engine
                java.util.Map<String, Object> loanData = new java.util.HashMap<>();
                loanData.put("loanAmount", loanAmount);
                loanData.put("propertyValue", propertyValue);
                loanData.put("dti", dti);
                loanData.put("ltv", ltv);
                loanData.put("creditScore", 720); // Default for test

                // Run decision engine
                com.soa.adapters.DecisionEngine.LoanDecision decision = engine.evaluateLoan(loanData);

                // Set decision results to BPEL variables
                setVariableData("decisionStatus", decision.getDecision());
                setVariableData("riskScore", Integer.valueOf(decision.getRiskScore()));

                addAuditTrailEntry("Decision Engine: " + decision.getDecision() +
                    ", Risk Score=" + decision.getRiskScore());
            ]]>
        </bpelx:exec>

        <!-- ============================================================== -->
        <!-- STEP 4: Pricing Calculation (AmortizationCalculator Adapter)   -->
        <!-- JAR: SCA-INF/lib/amortization-calculator.jar                   -->
        <!-- ============================================================== -->

        <bpelx:exec name="CalculatePricing" language="java">
            <![CDATA[
                // Instantiate the Amortization Calculator Java Adapter
                com.soa.adapters.AmortizationCalculator calculator = new com.soa.adapters.AmortizationCalculator();

                // Get loan data and LTV from previous steps
                double ltv = ((Double)getVariableData("ltvRatio")).doubleValue();
                int riskScore = ((Integer)getVariableData("riskScore")).intValue();
                double loanAmount = Double.parseDouble(
                    (String)getVariableData("inputVariable", "payload", "/types:LoanProcessRequest/types:loanAmount"));
                int termYears = 30; // Default 30-year mortgage

                // Calculate interest rate based on LTV and risk score
                // Map risk score (0-100) to credit score range (600-800)
                int creditScore = 600 + (riskScore * 2);
                double rate = calculator.calculateRate(ltv, creditScore, termYears);

                // Calculate monthly payment
                int termMonths = termYears * 12;
                double payment = calculator.calculateMonthlyPayment(loanAmount, rate, termMonths);

                // Set pricing results to BPEL variables
                setVariableData("interestRate", Double.valueOf(rate));
                setVariableData("monthlyPayment", Double.valueOf(payment));

                addAuditTrailEntry("Amortization Calculator: Rate=" + rate +
                    "%, Monthly Payment=$" + payment);
            ]]>
        </bpelx:exec>

        <!-- Assign all results to response -->
        <assign name="AssignResponse">
            <copy>
                <from>concat('LOAN-', ora:getProcessId())</from>
                <to>$outputVariable.payload/types:loanId</to>
            </copy>
            <copy>
                <from>'COMPLETED'</from>
                <to>$outputVariable.payload/types:status</to>
            </copy>
            <copy>
                <from>$decisionStatus</from>
                <to>$outputVariable.payload/types:decision</to>
            </copy>
            <copy>
                <from>$dtiRatio</from>
                <to>$outputVariable.payload/types:dtiRatio</to>
            </copy>
            <copy>
                <from>$ltvRatio</from>
                <to>$outputVariable.payload/types:ltvRatio</to>
            </copy>
            <copy>
                <from>$riskScore</from>
                <to>$outputVariable.payload/types:riskScore</to>
            </copy>
            <copy>
                <from>$monthlyPayment</from>
                <to>$outputVariable.payload/types:monthlyPayment</to>
            </copy>
            <copy>
                <from>$documentType</from>
                <to>$outputVariable.payload/types:documentClassification</to>
            </copy>
        </assign>

        <!-- Reply to client -->
        <reply name="ReplyResponse"
               partnerLink="LoanProcessClient"
               operation="processLoan"
               variable="outputVariable"/>

    </sequence>

</process>
