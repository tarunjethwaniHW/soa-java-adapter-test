<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:sca="http://xmlns.oracle.com/sca/1.0"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://xmlns.oracle.com/sca/1.0
           http://xmlns.oracle.com/sca/1.0">

    <!-- ================================================================== -->
    <!-- Document Classifier Spring Bean                                    -->
    <!-- Classifies documents by type (W2, paystub, tax return, etc.)       -->
    <!-- Exposed as SCA service for SOA composite integration               -->
    <!-- ================================================================== -->

    <bean id="docClassifierBean"
          class="com.soa.spring.DocClassifierImpl"
          scope="singleton"/>

    <!-- SCA Service Exposure -->
    <sca:service name="DocClassifierService"
                 type="com.soa.spring.IDocClassifier"
                 target="docClassifierBean"/>

</beans>
