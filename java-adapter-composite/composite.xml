<?xml version="1.0" encoding="UTF-8"?>
<composite name="JavaAdapterTestComposite"
           revision="1.0"
           label="Java Adapter Test - BPEL Java Embedding Patterns"
           mode="active"
           state="on"
           xmlns="http://xmlns.oracle.com/sca/1.0"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ui="http://xmlns.oracle.com/soa/designer/">

    <!-- ================================================================== -->
    <!-- Java Adapter Test Composite                                        -->
    <!-- Tests BPEL Java Embedding patterns for parser validation           -->
    <!--                                                                    -->
    <!-- Single BPEL orchestration with 4 <bpelx:exec> Java embeddings:     -->
    <!--   1. DTICalculator         - Calculate DTI/LTV ratios              -->
    <!--   2. OCRProcessor          - Document OCR processing               -->
    <!--   3. DecisionEngine        - Underwriting decision                 -->
    <!--   4. AmortizationCalculator - Pricing/payment calculations         -->
    <!-- ================================================================== -->

    <!-- Import WSDL -->
    <import namespace="http://xmlns.oracle.com/JavaAdapterTest/JavaAdapterProcess"
            location="JavaAdapterProcess.wsdl" importType="wsdl"/>

    <!-- ================================================================== -->
    <!-- Service Entry Point                                                -->
    <!-- ================================================================== -->

    <service name="javaadapter_client_ep" ui:wsdlLocation="JavaAdapterProcess.wsdl">
        <interface.wsdl interface="http://xmlns.oracle.com/JavaAdapterTest/JavaAdapterProcess#wsdl.interface(JavaAdapterProcess)"/>
        <binding.ws port="http://xmlns.oracle.com/JavaAdapterTest/JavaAdapterProcess#wsdl.endpoint(javaadapter_client_ep/JavaAdapterProcess_pt)">
            <property name="weblogic.wsee.wsat.transaction.flowOption" type="xs:string" many="false">NEVER</property>
        </binding.ws>
    </service>

    <!-- ================================================================== -->
    <!-- Loan Process Orchestration Component                               -->
    <!-- Single BPEL with multiple Java adapter embeddings                  -->
    <!-- ================================================================== -->

    <component name="LoanProcessOrchestration" version="2.0">
        <implementation.bpel src="LoanProcessOrchestration.bpel"/>
        <componentType>
            <service name="LoanProcessService" ui:wsdlLocation="JavaAdapterProcess.wsdl">
                <interface.wsdl interface="http://xmlns.oracle.com/JavaAdapterTest/JavaAdapterProcess#wsdl.interface(JavaAdapterProcess)"/>
            </service>
        </componentType>
        <property name="bpel.config.transaction" type="xs:string" many="false">required</property>
    </component>

    <!-- ================================================================== -->
    <!-- Wiring: Service Entry Point → BPEL Component                       -->
    <!-- ================================================================== -->

    <wire>
        <source.uri>javaadapter_client_ep</source.uri>
        <target.uri>LoanProcessOrchestration/LoanProcessService</target.uri>
    </wire>

    <!-- Wiring: BPEL Component → EJB References -->
    <wire>
        <source.uri>LoanProcessOrchestration/CreditCheckPartner</source.uri>
        <target.uri>CreditCheckEJB</target.uri>
    </wire>

    <wire>
        <source.uri>LoanProcessOrchestration/ComplianceCheckPartner</source.uri>
        <target.uri>ComplianceCheckEJB</target.uri>
    </wire>

    <!-- ================================================================== -->
    <!-- SPRING COMPONENTS                                                  -->
    <!-- Pattern: implementation.spring → Spring XML → Java Bean            -->
    <!-- ================================================================== -->

    <component name="RiskScorerComponent">
        <implementation.spring src="spring/risk-scorer-context.xml"/>
        <service name="RiskScorerService">
            <interface.java interface="com.soa.spring.IRiskScorer"/>
        </service>
    </component>

    <component name="DocClassifierComponent">
        <implementation.spring src="spring/doc-classifier-context.xml"/>
        <service name="DocClassifierService">
            <interface.java interface="com.soa.spring.IDocClassifier"/>
        </service>
    </component>

    <!-- ================================================================== -->
    <!-- EJB REFERENCES                                                     -->
    <!-- Pattern: reference + binding.ejb → Remote EJB on WebLogic          -->
    <!-- ================================================================== -->

    <reference name="CreditCheckEJB">
        <interface.java interface="com.soa.ejb.ICreditCheckRemote"/>
        <binding.ejb uri="CreditCheckEJB#com.soa.ejb.ICreditCheckRemote"
                     jndi-name="ejb/CreditCheck">
            <property name="java.naming.factory.initial" type="xs:string" many="false">weblogic.jndi.WLInitialContextFactory</property>
            <property name="java.naming.provider.url" type="xs:string" many="false">t3://localhost:7001</property>
        </binding.ejb>
    </reference>

    <reference name="ComplianceCheckEJB">
        <interface.java interface="com.soa.ejb.IComplianceCheckRemote"/>
        <binding.ejb uri="ComplianceCheckEJB#com.soa.ejb.IComplianceCheckRemote"
                     jndi-name="ejb/ComplianceCheck">
            <property name="java.naming.factory.initial" type="xs:string" many="false">weblogic.jndi.WLInitialContextFactory</property>
            <property name="java.naming.provider.url" type="xs:string" many="false">t3://compliance-server:7001</property>
        </binding.ejb>
    </reference>

</composite>
